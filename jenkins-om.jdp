
pipeline {
    agent any

    stages {
        stage('PULL') {
            steps {
                git branch: 'main', url: 'https://github.com/omkarambuskar612-source/om-jenkins.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'sonarqube',
                    credentialsId: 'sonarqube-credential'
                ) {
                    dir('backend') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=om-testing \
                            -Dsonar.projectName='om-testing'
                        '''
                    }
                }
                echo 'TEST SUCCESS'
            }
        }
         
        stage('QUALITY-GATE') {
            steps {
	        timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: false, credentialsId: 'sonarqube-credential'
                echo 'QUALITY-PASSED'
                }

                echo 'QUALITY-PASSED'                 
	    }    
        }
         
        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
