pipeline {
    agent any
    stages {
        stage('PULL') {
            steps {
                git branch: 'main', url: 'https://github.com/omkarambuskar612-source/om-jenkins.git'
                echo 'PULL SUCCESS'
            }
        }
        stage('BUILD') {
            steps {
                echo 'BUILD SUCCESS'
            }
        }
        stage('TEST') {
            steps {
                echo 'TEST SUCCESS'
            }
        }
        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
